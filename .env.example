# Niet-geheime omgevingsvariabelen voor lokale ontwikkeling en deploys.
# Kopieer naar `.env` (die staat in .gitignore) of zet ze in de shell waarin je
# `npx sst shell` / `npx sst deploy` draait. Beide worden door sst.config.ts
# doorgezet naar de Lambda-omgeving; ontbreken ze, dan faalt de deploy expliciet.
#
# Geheimen staan hier bewust NIET in (AD-5): GoogleOAuthClientSecret, TursoAuthToken,
# SessionPassword en TokenEncryptionKey lopen uitsluitend via `npx sst secret set`.
# Zie README.md.

# OAuth 2.0 Client ID uit de Google Cloud Console (Web application).
# Niet geheim; wordt als NUXT_OAUTH_OIDC_CLIENT_ID doorgezet.
GOOGLE_OAUTH_CLIENT_ID=

# libSQL-URL van de Turso-database, bijv. libsql://<naam>-<org>.turso.io
TURSO_DATABASE_URL=
